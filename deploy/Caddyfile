# Lobster dashboard API — HTTPS reverse proxy for the Oracle Cloud Linux VM.
#
# This is what was missing: a stable public HTTPS endpoint in front of the bot's
# dashboard API (port 3000) instead of a temporary tunnel.
#
# Steps:
#   1. Create a DNS A record (for example api.your-domain.example) pointing at
#      the VM's public IP address.
#   2. Open TCP 80 and 443 in the VM's Oracle Cloud Security List / NSG.
#      Do NOT open port 3000 publicly.
#   3. Install Caddy, copy this file to /etc/caddy/Caddyfile, and run:
#        sudo systemctl enable --now caddy
#      Caddy obtains and renews the TLS certificate automatically.
#   4. In Lobster's .env set:
#        DASHBOARD_REDIRECT_URI=https://api.your-domain.example/api/auth/callback
#        DASHBOARD_ORIGIN=https://your-dashboard-domain.example
#        DASHBOARD_TRUST_PROXY=true
#   5. In the Discord Developer Portal add the same redirect URI:
#        https://api.your-domain.example/api/auth/callback
#
# Replace api.your-domain.example below with your real API hostname.

api.your-domain.example {
	encode gzip
	reverse_proxy 127.0.0.1:3000
}
