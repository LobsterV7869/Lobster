# Enable the Server Members and Message Content intents in the Discord Developer Portal.
TOKEN=your-bot-token
CLIENT_ID=your-application-client-id
OWNER_ID=your-discord-user-id

# Discord OAuth2 web dashboard
OAUTH_CLIENT_SECRET=your-discord-oauth-client-secret

# Allowed dashboard origins. Comma-separated; the first HTTPS origin is treated
# as the primary one used for redirects. Add extra origins (for example a Vercel
# preview deployment) after a comma. Never include a trailing slash.
DASHBOARD_ORIGIN=https://your-dashboard-domain.example

# Public HTTPS URL of this API that Discord redirects back to after login.
DASHBOARD_REDIRECT_URI=https://your-bot-api.example/api/auth/callback

# Where the dashboard lives after a successful sign-in (must share an allowed origin above).
DASHBOARD_RETURN_URL=https://your-dashboard-domain.example/dashboard

DASHBOARD_PORT=3000
DASHBOARD_SESSION_SECRET=replace-with-a-long-random-secret

# Set true only when requests arrive through your trusted HTTPS reverse proxy.
DASHBOARD_TRUST_PROXY=true
